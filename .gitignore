# Quartus scratch / build state
db/
incremental_db/
greybox_tmp/
output/
build/
.home/
*.rpt
*.summary
*.smsg
*.cdf
*.jdi
*.qws
*.qar
*.qarlog
c5_pin_model_dump.txt
cr_ie_info.json
*_assignment_defaults.qdf
PLLJ_PLLMGS_INFO.txt
*.bak
*.ap-tool-bak

# programming files are artifacts, not sources (the template ships its own
# exception files inside src/fpga/output_files/.gitignore)
*.sof
*.rbf
*.rbf_r
*.pof
*.svf
*.vip

# keep the reference bitstreams that Analogue ships inside the template
!cores/core-template/output/bitstream.rbf_r
!cores/core-template/src/fpga/output_files/*.rbf
!cores/core-template/src/fpga/output_files/*.sof

# the APF regenerates build_id.mif (build date/time) at the start of every
# compile. core-template tracks its own copy, which is why it shows as modified
# after any build; for our own cores keep it out so git status stays clean.
cores/*/src/fpga/apf/build_id.mif

# vendored / ported cores are usually their own repos - decide per core
# cores/mygame/

# python bytecode from the packaging scripts
__pycache__/
*.pyc

# agent/session state
.pi/

# editor noise
.idea/
.vscode/
*.swp

# --- Another World (a5k) port -------------------------------------------------
# upstream design: fetched by ports/another-world/fetch_upstream.sh, pinned in UPSTREAM_PIN
ports/another-world/upstream/
# Silice build trees and the user's own game files / converted packs
**/BUILD_*/
ports/another-world/gamedata/
ports/another-world/roms/
# probe synthesis state. Each probe/<name>/<variant>/ project dir is written by
# that probe's own run.sh heredoc - it does `rm -rf` on it before every run - so
# it is output, not source; tracking it would freeze a stale copy (c1_192 and
# c1_240 already exist although run.sh now loops over 160 only). Keep the .v and
# .sdc sources and the run*.sh scripts.
ports/**/db/
ports/**/incremental_db/
ports/**/output_files/
ports/**/*.log
ports/another-world/probe/c1rom/c1_*/
ports/another-world/probe/c1rom/budget/
ports/another-world/probe/pll/pllp_*/
ports/another-world/probe/ramshape/rs_*/
# generated upstream output - regenerate with the command in docs/another-world/feasibility-probes.md
ports/another-world/probe/build.v

# --- licensed game data -------------------------------------------------------
# The user's own game files and the packs extracted from them. Nothing here is
# ours to publish, and the packs are 17 MB of derived binaries: keep them out of
# every commit, including an accidental `git add .`.
gamedata/
ports/another-world/packs/

# --- generated SoC netlist ----------------------------------------------------
# cores/aw/src/fpga/core/aw_pocket_build.v is produced by `make pocket-translate`
# from cores/aw/src/si/aw_pocket.si plus the pinned upstream vm.si. Nobody edits
# it; a fresh clone must run that target before `make build` (scripts/build.sh
# says so explicitly if the file is missing).
cores/*/src/fpga/core/aw_pocket_build.v

# --- simulator scratch --------------------------------------------------------
# Verilator writes its --Mdir wherever it is run from; a bare relative path once
# put 137 MB of it at the repo root.
/obj*/
obj_*/
# Silice writes its generated netlist and .lpp annotations next to the probe .si.
# Same rule as ports/another-world/probe/build.v: it is generated output, and the
# probe's run script regenerates it.
ports/**/gen/

# --- bring-up scratch that is not source --------------------------------------
# Stray build logs (scripts/build.sh writes its log under build/, so anything at
# the repo root is a manual redirect that outlived the run it described).
/build*.log
# Packs staged for packaging: derived from the user's own game files (17 MB of
# licensed binaries the extractor drops here). Regenerate with scripts/make_packs.
cores/aw/dist/
# The Chip32 loader image is assembled from cores/aw/support/loader.asm by
# `make loader` (scripts/build_loader.sh); the .asm is the source, the .bin is
# output that package_core.py copies into the SD tree.
cores/*/loader.bin
# Superseded per-build SD installers. Each one guarded the exact SHA of the bit
# it was written for, so they are useful while a build is live and dead weight
# afterwards; the running record of what each build tested is docs/another-world/
# port-log.md. The current installer stays tracked.
scripts/sd_install_102*.sh
scripts/sd_install_103[0-4]*.sh
