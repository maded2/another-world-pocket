# ============================================================================
# Silice toolchain image - ONLY needed for the Another World (a5k) port.
#
# a5k is written in Silice, not Verilog, and Silice's frontend is a C++/ANTLR
# compiler that needs a JDK to build.  This image builds Silice and provides
# `silice` / `silice-make.py` so the a5k design can be translated to Verilog,
# which is the input the Pocket (Quartus) flow actually consumes.
#
#   make silice-image                                  # or:
#   docker build -f docker/Dockerfile.silice -t local/ap-silice:latest .
#   ./docker/run-silice.sh <command>
#
# Run it with docker/run-silice.sh, not a bare `docker run`: the wrapper maps
# your uid/gid so the BUILD_* trees Silice writes into the repo stay yours.
# As root they come out root:root 755 and cannot be deleted without sudo.
#
# Deliberately separate from the Quartus image: different base, different job.
# ============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git curl \
        build-essential cmake pkg-config \
        default-jdk-headless \
        python3 python3-pip \
        libreadline-dev zlib1g-dev uuid-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --no-cache-dir termcolor edalize Jinja2

# Build Silice from source (its src/ is a C++ compiler; bin/ holds the drivers)
ARG SILICE_REF=master
RUN git clone --depth 1 --branch ${SILICE_REF} https://github.com/sylefeb/Silice.git /opt/Silice \
 && cd /opt/Silice \
 && git submodule update --init --recursive src/libs/LibSL-small python/pybind11 \
 && mkdir -p BUILD/build-silice && cd BUILD/build-silice \
 && cmake -DCMAKE_BUILD_TYPE=Release -G "Unix Makefiles" ../.. \
 && make -j"$(nproc)" \
 && make install \
 && (command -v silice || ls -l /usr/local/bin | grep -i silice)

# Simulators, for the design-side checks in scripts/sim_*.sh: iverilog to lint and
# smoke-test the glue RTL quickly (Quartus takes minutes to report a typo), and
# verilator to run the translated design against a model of the Pocket side.
# libgl/libglu/libsdl2 are not needed to translate Silice to Verilog, but they are
# needed to build Silice's *verilator simulator framework* (frameworks/verilator/
# display.cpp includes GL/gl.h). Without them the upstream golden reference sim
# cannot be built here at all - and that reference sim is how this port validates
# behaviour instead of guessing from rendered frames. Note silice-make.py exits 0
# even when the make it launches fails, so a missing header here looks like a
# successful build that produces no executable.
RUN apt-get update && apt-get install -y --no-install-recommends \
        iverilog verilator \
        libgl1-mesa-dev libglu1-mesa-dev libsdl2-dev libglfw3-dev \
        xvfb x11-apps netpbm \
    && rm -rf /var/lib/apt/lists/*

ENV SILICE_ROOT=/opt/Silice \
    PYTHONPATH=/opt/Silice/python

WORKDIR /work
CMD ["bash"]
